<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://orderItemDetailView.title"
      focusComponent="form">
    <data>
        <instance id="orderItemDc"
                  class="com.company.crmfromdb.entity.OrderItem">
            <fetchPlan extends="_base">
                <property name="order" fetchPlan="_base"/>
                <property name="categoryItem" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="orderItemDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="orderItemDc">
            <entityPicker id="orderField" property="order">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <entityPicker id="categoryItemField" property="categoryItem">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <bigDecimalField id="quantityField" property="quantity"/>
            <bigDecimalField id="discountField" property="discount"/>
            <bigDecimalField id="netPriceField" property="netPrice"/>
            <bigDecimalField id="vatField" property="vat"/>
            <bigDecimalField id="grossPriceField" property="grossPrice"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
