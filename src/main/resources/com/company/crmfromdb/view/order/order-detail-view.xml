<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://orderDetailView.title"
      focusComponent="form">
    <data>
        <instance id="orderDc"
                  class="com.company.crmfromdb.entity.Order">
            <fetchPlan extends="_base">
                <property name="client" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="orderDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="orderDc">
            <textField id="numberField" property="number"/>
            <entityPicker id="clientField" property="client">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <datePicker id="dateField" property="date"/>
            <textField id="purchaseOrderField" property="purchaseOrder"/>
            <select id="statusField" property="status"/>
            <bigDecimalField id="totalField" property="total"/>
            <bigDecimalField id="discountValueField" property="discountValue"/>
            <bigDecimalField id="discountPercentField" property="discountPercent"/>
            <textArea id="commentField" property="comment" height="9.5em"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
